APP_ENV=production
APP_DEBUG=false
APP_URL=https://core.example.com
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
# Demo mode shows a banner and enables scripts/demo-reset.php (which refuses unless the database name contains "demo").
DEMO_MODE=false

# 32 random bytes, base64. Encrypts National Insurance and bank details. php -r "echo base64_encode(random_bytes(32));"
APP_KEY=

# Sign in with Microsoft (Entra ID). Leave blank to use passwords only.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Defaults to APP_URL + /login/entra/callback
ENTRA_REDIRECT_URI=
# false = only administrators may use a password once Microsoft sign-in is configured
PASSWORD_LOGIN=true

# Demo only: an administrator login of your own that survives the nightly demo reset. Make the hash on your own
# computer so the password never appears anywhere else:
#   php -r 'echo password_hash(trim(fgets(STDIN)), PASSWORD_DEFAULT), PHP_EOL;'      (type the password, press Enter)
OWNER_EMAIL=
OWNER_PASSWORD_HASH=
